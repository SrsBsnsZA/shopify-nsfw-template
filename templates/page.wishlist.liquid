{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'product-grid-3.css' | asset_url | stylesheet_tag }}

<style>
.product-grid .grid__item {
    padding: 0 15px;
}
.container--wishlist .media img{
  position: relative;
  width: 100%;
  height: auto; 
}

.container--wishlist .grid__item{
  margin-bottom: 20px;
}

.js-btn-remove-wishlist{
    background: #f44336;
    opacity: 0.8;
    border: none;
    padding: 5px 15px;
    color: #fff;
    border-radius: 3px;
}

.js-btn-remove-wishlist:hover{
  opacity: 1;
}

.container--wishlist .grid__item{
  text-align: center;
}

.container--wishlist .card-information__text{
  font-size: 1.6rem;
}
</style>
<product-wishlistpage>
  <div class="page-width container--wishlist">
        <div id="ratingIcons" style="display: none;"
            data-lemoan="{{ settings.lemoan_button | img_url: 'small' }}"
            data-mild="{{ settings.mild_button | img_url: 'small' }}"
            data-hot="{{ settings.hot_button | img_url: 'small' }}"
            data-xxx="{{ settings.xxx_button | img_url: 'small' }}"
            data-hard="{{ settings.hard_button | img_url: 'small' }}"
        ></div>
      <div class="content-block">
          <h1 class="text-center">Wishlist</h1>
          <div class="row js-wishlist-content">
                <ul class="grid grid--2-col grid--3-col-tablet grid--one-third-max grid--4-col-desktop grid--quarter-max product-grid">
                </ul>
          </div>
          <h2 id="wishlistEmpty" class="text-center" style="display: none;">There is FUCK ALL in your wishlist, go shop!</h2>
      </div>
  </div>
</product-wishlistpage>
